# Copy to .env at the repository root and fill in. Never commit .env.
#
# One .env for the whole monorepo, deliberately: docker compose reads this same file
# both for variable interpolation (the db service credentials) and for the api
# container's environment. Splitting it per app breaks interpolation silently.

APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=syncaai
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=syncaai

# Points at the host, so uvicorn, alembic and pytest work outside Docker with no
# override. Compose replaces it with db:5432 for the api container, built from the
# POSTGRES_* values above, so the credentials live in one place.
DATABASE_URL=postgresql+psycopg://syncaai:change_me_locally@localhost:5433/syncaai

# Signing secret for access tokens (ADR-0015). No default in the application: a
# fallback value would work in development and silently ship a known key.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_value
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Rate limits, per caller address per hour. The production values are the defaults in
# config.py — 10 logins, 5 registrations, 3 verification resends — and they are low on
# purpose: each attempt costs a 64 MiB argon2 hash (ADR-0014).
#
# They are raised here because building a login screen means signing in dozens of times,
# the counter is keyed by address and persists in the database, so it survives restarting
# the API and you end up locked out of your own machine.
#
# A high number rather than a flag that turns the limiter off. A misconfigured number in
# production is a limit that is too generous; a flag that leaked there would be no limit
# at all, which is the memory-exhaustion vector the ADR named.
LOGIN_ATTEMPTS_PER_HOUR=1000
REGISTRATIONS_PER_HOUR=1000
VERIFICATION_RESENDS_PER_HOUR=1000

# Where verification and password reset mail goes. `console` writes it to the API log, so
# the confirmation token appears in the terminal running uvicorn — that is how you finish
# a sign-up locally, until the domain and provider exist.
MAIL_BACKEND=console

# AI provider. Not used yet: introduced with plan generation (ADR-0003).
# This key must never reach the browser.
# AI_PROVIDER_API_KEY=
# AI_MODEL=
# AI_REQUEST_TIMEOUT_SECONDS=30
