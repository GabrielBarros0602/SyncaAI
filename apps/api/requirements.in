# Runtime dependencies.
#
# Regenerate the lockfile after editing this file:
#   uv pip compile --universal --python-version 3.12 requirements.in -o requirements.txt
#
# Universal mode is deliberate: development happens on Windows and the runtime is Linux,
# so the lockfile carries environment markers and is valid on both. See CONTRIBUTING.md.
fastapi

# EmailStr, for rejecting malformed addresses at the boundary. Pydantic disables the
# deliverability check, so no DNS lookup happens per request.
pydantic[email]
uvicorn[standard]
pydantic-settings
sqlalchemy
alembic
psycopg[binary]

# The IANA time zone database as a package. python:3.12-slim does not ship the system
# database, so zoneinfo would raise ZoneInfoNotFoundError in the container while working
# fine on a developer machine — a failure that only appears after deploy.
tzdata

# Password hashing (ADR-0014) and access tokens (ADR-0015).
argon2-cffi
pyjwt
