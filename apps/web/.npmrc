# Refuse to install on a Node the project does not support, rather than warning about it.
#
# Without this, `engines` is advisory: npm prints a notice nobody reads and installs anyway.
# The failure it prevents is not theoretical — this repository ran on Node 20 while CI ran
# 22, and the whole web suite failed to start locally for weeks with a green build to look
# at. A rule worth writing down is a rule worth enforcing, which is the same reason the
# overlap constraint lives in PostgreSQL and not in a service.
engine-strict=true
